{
  "name": "runout-backend",
  "version": "0.1.0",
  "description": "RunOut personal fields API (Cloudflare Worker + D1)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create runout_personal_fields",
    "db:init": "wrangler d1 execute runout_personal_fields --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute runout_personal_fields --local --file schema.sql",
    "secret:enc": "wrangler secret put ENC_KEY"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  },
  "license": "MIT"
}
